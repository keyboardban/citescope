# Copy this file to ".env" and fill in your keys.
# These are read at runtime via python-dotenv. Never commit the real .env.

# Google AI Studio / Gemini API key  -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Apify API token  -> https://console.apify.com/account/integrations
APIFY_TOKEN=

# Bright Data Dataset / Crawler API. Rotate exposed keys before use.
BRIGHTDATA_API_KEY=
BRIGHTDATA_PROVIDER_MODE=crawler_api
BRIGHTDATA_CRAWLER_DATASET_ID=
BRIGHTDATA_CRAWLER_ASYNC=true
BRIGHTDATA_CRAWLER_ENDPOINT=https://api.brightdata.com/datasets/v3/trigger
# BRIGHTDATA_CRAWLER_POLL_SECONDS=10
# BRIGHTDATA_CRAWLER_WAIT_SECONDS=1800
# BRIGHTDATA_TIMEOUT_SECONDS=60

# Read-only location of the existing research archive and generated datasets.
# CITESCOPE_RESEARCH_DATA_DIR=/absolute/path/to/CompareSearch-v2-clean
# CITESCOPE_ECONOMETRICS_DATA_DIR=/absolute/path/to/data/econometrics_v2
# CITESCOPE_ECONOMETRICS_OUTPUT_DIR=/absolute/path/to/outputs/econometrics_eda_v2
# Optional files for the built-in Previous Area Condo 500 preset.
# CITESCOPE_AREA_CONDO_PROMPT_MANIFEST=/absolute/path/to/area_condo_nonbranded_prompt_manifest_500.csv
# CITESCOPE_AREA_CONDO_BRIGHTDATA_INPUT=/absolute/path/to/area_condo_nonbranded_brightdata_input_500.csv
# CITESCOPE_AREA_CONDO_BRIGHTDATA_OUTPUT=/absolute/path/to/01_area_condo_nonbranded_brightdata_run_1.json
# Optional override for the URL-level Gemini taxonomy audit CSV.
# CITESCOPE_GEMINI_TAXONOMY_PATH=/absolute/path/to/all_pages_gemini_taxonomy_classifications.csv

# ---- optional overrides (sensible defaults are used if unset) ----
# APIFY_SERP_ACTOR=apify/google-search-scraper
# APIFY_SCRAPER_ACTOR=apify/website-content-crawler
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=text-embedding-004
# Semantic position-feature smoke classifier (QA only until manually validated).
# CITESCOPE_POSITION_GEMINI_MODEL=gemini-3.1-flash-lite
